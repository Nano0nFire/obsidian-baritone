{
  "name": "obsidian-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time, self-hostable Obsidian vault sync (2-layer: file-level + Yjs CRDT)",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "apps/plugin"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
