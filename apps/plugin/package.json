{
  "name": "obsidian-sync-plugin",
  "version": "0.3.0",
  "description": "Obsidian client for self-hosted real-time vault sync",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "version-bump": "node scripts/version-bump.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@obsidian-sync/shared": "0.1.0",
    "@codemirror/merge": "^6.7.0",
    "fast-diff": "^1.3.0",
    "yjs": "^13.6.18",
    "y-protocols": "^1.0.6",
    "y-codemirror.next": "^0.3.5",
    "lib0": "^0.2.99"
  },
  "devDependencies": {
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@types/node": "^22.7.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
