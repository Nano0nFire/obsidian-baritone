# ============================================================================
# Obsidian Sync Server environment template
# Run ./setup.sh to generate deploy/.env, or copy this file to .env and edit it.
# Contract: the server reads DATABASE_URL (or POSTGRES_* for bundled DB
# initialization), S3_*, JWT_SECRET, SERVER_PORT, PUBLIC_URL, and
# TRASH_RETENTION_DAYS. Compose-only variables are marked below.
# ============================================================================

# --- Docker Compose only -----------------------------------------------------
COMPOSE_PROJECT_NAME=obsidian-sync
# Enable bundled services as needed: bundled-db,bundled-minio,tls-caddy
COMPOSE_PROFILES=bundled-db,bundled-minio

# --- Server -----------------------------------------------------------------
SERVER_PORT=3000
PUBLIC_URL=http://localhost:3000
TRASH_RETENTION_DAYS=30
JWT_SECRET=change-me-use-openssl-rand-hex-32

# --- Database ---------------------------------------------------------------
# DB_MODE is consumed by setup.sh/docs; the server should use DATABASE_URL.
DB_MODE=bundled
DATABASE_URL=postgres://obsidian:CHANGE_ME@postgres:5432/obsidian_sync
# Used by the bundled postgres container and by setup.sh for URL construction.
POSTGRES_DB=obsidian_sync
POSTGRES_USER=obsidian
POSTGRES_PASSWORD=CHANGE_ME
PGHOST=postgres
PGPORT=5432
PGSSLMODE=disable
PG_DATA_DIR=./data/postgres

# --- Object storage (S3/MinIO) ---------------------------------------------
# OBJ_MODE is consumed by setup.sh/docs; the server should use S3_*.
OBJ_MODE=bundled
S3_ENDPOINT=http://minio:9000
S3_BUCKET=obsidian-blobs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1
# Used only by the bundled MinIO container.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_DATA_DIR=./data/minio

# --- TLS / Caddy (Compose only, tls-caddy profile) --------------------------
TLS_MODE=none
CADDY_DOMAIN=
CADDY_EMAIL=

# --- Bootstrap (setup.sh only; not required at runtime) ---------------------
ADMIN_USER=admin
# Leave blank in setup.sh to generate one. For manual CLI use, pass explicitly.
ADMIN_PW=
