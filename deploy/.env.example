# ============================================================================
# Obsidian Sync Server environment template
# Run ./setup.sh to generate deploy/.env, or copy this file to .env and edit it.
# Contract: the server reads DATABASE_URL, S3_*, JWT_SECRET, SERVER_PORT,
# PUBLIC_URL, TRASH_RETENTION_DAYS, LOG_LEVEL, rate-limit settings,
# Yjs history/GC settings, and SHUTDOWN_TIMEOUT_MS. Compose-only variables are marked below.
# ============================================================================

# --- Docker Compose only -----------------------------------------------------
COMPOSE_PROJECT_NAME=obsidian-sync
# Enable bundled services as needed: bundled-db,bundled-minio,tls-caddy
COMPOSE_PROFILES=bundled-db,bundled-minio

# --- Server -----------------------------------------------------------------
SERVER_PORT=3000
PUBLIC_URL=http://localhost:3000
TRASH_RETENTION_DAYS=30
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
JWT_SECRET=change-me-use-openssl-rand-hex-32

# --- Rate limiting ----------------------------------------------------------
# TRUST_PROXY: set to "true" only when the server sits behind a reverse proxy
# you control (e.g. Caddy/nginx). When true, the login rate limiter and audit
# logs honor the X-Forwarded-For header for the client IP. Leave false/unset
# when the server is exposed directly, otherwise clients can spoof X-Forwarded-For
# to bypass per-IP login throttling.
TRUST_PROXY=false
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_LOCKOUT_MS=300000
WS_CONNECTION_RATE_LIMIT_MAX=30
WS_CONNECTION_RATE_LIMIT_WINDOW_MS=60000
WS_MESSAGE_RATE_LIMIT_MAX=120
WS_MESSAGE_RATE_LIMIT_WINDOW_MS=10000
YJS_UPDATE_RATE_LIMIT_MAX=120
YJS_UPDATE_RATE_LIMIT_WINDOW_MS=10000

# --- Yjs snapshot history / GC ----------------------------------------------
YJS_SNAPSHOT_EVERY_UPDATES=20
YJS_HISTORY_RETAINED_VERSIONS=100
YJS_HISTORY_GC_INTERVAL_MS=3600000

# --- Database ---------------------------------------------------------------
# DB_MODE is consumed by setup.sh/docs; the server should use DATABASE_URL.
DB_MODE=bundled
DATABASE_URL=postgres://obsidian:CHANGE_ME@postgres:5432/obsidian_sync
# Used by the bundled postgres container and by setup.sh for URL construction.
POSTGRES_DB=obsidian_sync
POSTGRES_USER=obsidian
POSTGRES_PASSWORD=CHANGE_ME
PGHOST=postgres
PGPORT=5432
PGSSLMODE=disable
PG_DATA_DIR=./data/postgres

# --- Object storage (S3/MinIO) ---------------------------------------------
# OBJ_MODE is consumed by setup.sh/docs; the server should use S3_*.
OBJ_MODE=bundled
S3_ENDPOINT=http://minio:9000
S3_BUCKET=obsidian-blobs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1
# Used only by the bundled MinIO container.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_DATA_DIR=./data/minio

# --- TLS / Caddy (Compose only, tls-caddy profile) --------------------------
TLS_MODE=none
CADDY_DOMAIN=
CADDY_EMAIL=

# --- Bootstrap (setup.sh only; not required at runtime) ---------------------
ADMIN_USER=admin
# Leave blank in setup.sh to generate one. For manual CLI use, pass explicitly.
ADMIN_PW=
